<div id="loading">
  <div class="loader" role="status" aria-label="加载中">
    <span class="ring"></span>
    <span class="ring ring-2"></span>
    <span class="core"></span>
  </div>
</div>

<style>
  #loading {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: var(--z-search-overlay);
    background-color: var(--grey-1);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
    transition: opacity 0.4s ease-out;
  }

  .loader {
    position: relative;
    width: 6.5em;
    height: 6.5em;
    font-size: 10px;
  }

  .loader .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 0.5em solid color-mix(in oklch, var(--primary-color) 22%, transparent);
    border-top-color: var(--primary-color);
    animation: loader-spin 1.15s cubic-bezier(0.6, 0.2, 0.4, 0.8) infinite;
  }

  .loader .ring-2 {
    inset: 1.5em;
    border: 0.45em solid color-mix(in oklch, var(--primary-color) 16%, transparent);
    border-bottom-color: var(--primary-color);
    animation: loader-spin 1.7s linear infinite reverse;
  }

  .loader .core {
    position: absolute;
    inset: 2.6em;
    border-radius: 50%;
    background: var(--primary-color);
    box-shadow: 0 0 1.2em color-mix(in oklch, var(--primary-color) 55%, transparent);
    animation: loader-pulse 1.15s ease-in-out infinite;
  }

  .loader:hover .ring,
  .loader:hover .ring-2,
  .loader:hover .core {
    animation-play-state: paused;
  }

  @keyframes loader-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes loader-pulse {
    0%,
    100% {
      transform: scale(0.72);
      opacity: 0.6;
    }
    50% {
      transform: scale(1);
      opacity: 1;
    }
  }

  #loading.hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const MINIMUM_LOADING_TIME = 500;

  // TODO: 仅在第一次访问时显示加载动画
  window.addEventListener("DOMContentLoaded", () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const loading = document.querySelector("#loading");
        if (!loading) return;

        setTimeout(() => {
          loading.classList.add("hidden");
        }, MINIMUM_LOADING_TIME);
      });
    });
  });
</script>
