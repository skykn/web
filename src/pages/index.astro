---
import Layout from "../layouts/Layout.astro";
import IndexContent from "../components/IndexContent.astro";
import Pagination from "../components/Pagination.astro";
import { getCollection } from "astro:content";
import themeConfig from "@/theme.config";

// 首页四大板块卡片封面（统一靛蓝冷调，占位见 category-card.css 的渐变兜底色）
import categoryNewsCover from "@/assets/images/categories/category-news.jpg";
import categoryTechCover from "@/assets/images/categories/category-tech.jpg";
import categoryWorksCover from "@/assets/images/categories/category-works.jpg";
import categoryLifeCover from "@/assets/images/categories/category-life.jpg";
import type { ImageMetadata } from "astro";

const categoryCoverMap: Record<string, ImageMetadata> = {
  资讯新闻: categoryNewsCover,
  技术载文: categoryTechCover,
  作品陈列: categoryWorksCover,
  浮生札录: categoryLifeCover,
};

// Fetch all posts
const allPosts = await getCollection("posts");

// Filter out drafts
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// Separate sticky posts and regular posts
const stickyPosts = publishedPosts
  .filter((post) => post.data.sticky === true)
  .toSorted(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const regularPosts = publishedPosts
  .filter((post) => !post.data.sticky)
  .toSorted(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const pageSize = themeConfig.home?.pageSize ?? 10;
const lastPage = Math.max(1, Math.ceil(regularPosts.length / pageSize));
const currentPage = 1;
const pagePosts = regularPosts.slice(0, pageSize);

// Build pagination navigation
const paginationNavigation = {
  prevUrl: undefined,
  nextUrl: lastPage > 1 ? "/page/2/" : undefined,
};

// Build category list with post counts
const categoryMap = new Map<
  string,
  {
    name: string;
    posts: Array<{ title: string; slug: string }>;
  }
>();

publishedPosts.forEach((post) => {
  const categories = post.data.categories || [];
  categories.forEach((cat) => {
    if (!categoryMap.has(cat)) {
      categoryMap.set(cat, {
        name: cat,
        posts: [],
      });
    }
    categoryMap.get(cat)!.posts.push({
      title: post.data.title,
      slug: post.id,
    });
  });
});

// Transform categories for CategoryCards component
// 顺序以 selectedCategories 配置为准（此前按 postCount 排序导致配置顺序不生效），数量作次级排序
const selectedCategoryOrder = (name: string): number => {
  const index = themeConfig.home?.selectedCategories?.findIndex((cat) => cat.name === name);
  return index === undefined || index < 0 ? Number.MAX_SAFE_INTEGER : index;
};

const categories = Array.from(categoryMap.entries())
  .filter(([name, _]) =>
    themeConfig.home?.selectedCategories?.some((cat) => cat.name === name),
  )
  .map(([name, data]) => ({
    name,
    // theme.config 显式配置优先，否则使用内置的四大板块封面
    cover:
      themeConfig.home?.selectedCategories?.find((cat) => cat.name === name)?.cover ??
      categoryCoverMap[name]?.src,
    url: `/categories/${name}/`,
    postCount: data.posts.length,
    posts: data.posts.slice(0, 6).map((p) => ({
      title: p.title,
      url: `/posts/${p.slug}/`,
    })),
  }))
  .toSorted(
    (a, b) =>
      selectedCategoryOrder(a.name) - selectedCategoryOrder(b.name) || b.postCount - a.postCount,
  );

let pageTitle = themeConfig.home?.title?.customTitle ?? "";

if (themeConfig.home?.title?.behavior === "default") {
  pageTitle =
    `${themeConfig.brand?.logo || ""} · ${themeConfig.brand?.title || ""} · ${themeConfig.brand?.subtitle || ""}`.trim();
}
---

<Layout
  pageTitle={pageTitle}
  indexPage={true}
  navigation={paginationNavigation}
>
  <Fragment slot="head">
    <meta name="description" content={themeConfig.sidebar?.description} />
  </Fragment>

  <IndexContent
    posts={pagePosts}
    stickyPosts={stickyPosts}
    categories={categories}
    isFirstPage={true}
  />
  <Pagination
    currentPage={currentPage}
    lastPage={lastPage}
    firstPageHref="/"
    routePrefix="/page"
  />
</Layout>
